# Setup-GPOWatchdog.ps1
# Dieses Skript muss im interaktiven Benutzerkontext ausgeführt werden (NICHT "Als Administrator ausführen").

# Konfiguration
$TaskName = "GPO-Watchdog"
$ScriptPath = "C:\Users\Public\10020115_WinScripts\10020115_Win_S_Watchdog.ps1"
$RunKeyPath = "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run"
$RunKeyName = "GPOWatchdogStarter"
$RunKeyValue = "schtasks.exe /run /tn `"$TaskName`""

# 0) Prüfen, ob wir im erwarteten Benutzerkontext laufen
$expectedUser = "$env:COMPUTERNAME\DLRG-JugendAndernach"
$currentUser = (Get-WmiObject Win32_ComputerSystem).UserName

Write-Host "Erwarteter Benutzer: $expectedUser"
Write-Host "Aktueller Benutzer:  $currentUser"

if ($currentUser -ne $expectedUser) {
    Write-Host ""
    Write-Host "FEHLER: Dieses Skript muss als der Benutzer '$expectedUser' ausgeführt werden."
    Write-Host "Bitte PowerShell normal (nicht erhöht) öffnen und das Skript erneut starten."
    exit 1
}

# 1) Alte Aufgabe entfernen (falls vorhanden)
if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
    Write-Host "Vorhandene Aufgabe entfernt."
}

# 2) Aufgabe erstellen (ohne Trigger; wird per RunKey gestartet)
$action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$ScriptPath`""

# Principal: explizit der interaktive Benutzer
$principal = New-ScheduledTaskPrincipal -UserId $currentUser -RunLevel Highest

try {
    Register-ScheduledTask -TaskName $TaskName -Action $action -Principal $principal -ErrorAction Stop
    Write-Host "Aufgabe '$TaskName' erfolgreich registriert unter Principal: $currentUser"
} catch {
    Write-Host "FEHLER beim Registrieren der Aufgabe: $_"
    exit 2
}

# 3) Run-Key setzen (Startet die Aufgabe beim Logon)
if (Get-ItemProperty -Path $RunKeyPath -Name $RunKeyName -ErrorAction SilentlyContinue) {
    Set-ItemProperty -Path $RunKeyPath -Name $RunKeyName -Value $RunKeyValue
    Write-Host "Run-Key aktualisiert."
} else {
    New-ItemProperty -Path $RunKeyPath -Name $RunKeyName -Value $RunKeyValue -PropertyType String | Out-Null
    Write-Host "Run-Key erstellt."
}

# 4) Kontrolle: Task anzeigen
Start-Sleep -Seconds 1
Get-ScheduledTask -TaskName $TaskName | Select-Object TaskName, @{Name='Principal';Expression={$_.Principal.UserId}} | Format-List

Write-Host "Setup abgeschlossen."

